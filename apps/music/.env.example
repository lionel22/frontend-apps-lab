# Example runtime configuration for the music frontend

HOST=0.0.0.0
PORT=3000

# Canonical Nuxt runtime override, including built Nitro preview/server.
NUXT_PUBLIC_MUSIC_API_BASE_URL=http://127.0.0.1:3100

# Compatibility fallback for the current nuxt.config default.
NUXT_PUBLIC_MUSIC_API_URL=http://127.0.0.1:3100

NUXT_PUBLIC_MUSIC_POLLING_INTERVAL_DEFAULT=15000
NUXT_PUBLIC_MUSIC_REQUIRE_AUTH=true
NUXT_PUBLIC_MUSIC_AUTH_STORAGE_KEY=music.operator.session