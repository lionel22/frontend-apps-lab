# Example runtime configuration for the music frontend

HOST=0.0.0.0
PORT=3000

# Canonical Nuxt runtime override, including built Nitro preview/server.
NUXT_PUBLIC_MUSIC_API_BASE_URL=http://127.0.0.1:3100

# Compatibility fallback for the current nuxt.config default.
NUXT_PUBLIC_MUSIC_API_URL=http://127.0.0.1:3100

NUXT_PUBLIC_MUSIC_POLLING_INTERVAL_DEFAULT=15000
NUXT_PUBLIC_MUSIC_REQUIRE_AUTH=true
NUXT_PUBLIC_MUSIC_AUTH_STORAGE_KEY=music.operator.session

# Frontend observability
NUXT_PUBLIC_OBSERVABILITY_APP_NAME=music-frontend
NUXT_PUBLIC_OBSERVABILITY_APP_VERSION=0.0.0
NUXT_PUBLIC_OBSERVABILITY_ENVIRONMENT=local

# Grafana Faro / Alloy receiver
NUXT_PUBLIC_FARO_ENABLED=false
NUXT_PUBLIC_FARO_URL=
NUXT_PUBLIC_FARO_API_KEY=
NUXT_PUBLIC_FARO_SAMPLE_RATE=1

# OpenReplay selective session replay
NUXT_PUBLIC_OPENREPLAY_ENABLED=false
NUXT_PUBLIC_OPENREPLAY_PROJECT_KEY=
NUXT_PUBLIC_OPENREPLAY_INGEST_POINT=
NUXT_PUBLIC_OPENREPLAY_SAMPLE_RATE=0.1
